{
  "name": "@pi-contrib/pi-classifier",
  "version": "0.2.2",
  "description": "Missing classifier and decision models for Pi providers",
  "license": "MIT",
  "type": "module",
  "repository": "https://github.com/pi-contrib/pi-classifier.git",
  "keywords": [
    "pi-package",
    "classifier",
    "opencode-go"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./providers/*": "./src/providers/*.ts"
  },
  "files": [
    "src"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check src test biome.json package.json tsconfig.json",
    "format": "biome check --write src test biome.json package.json tsconfig.json",
    "test": "node --experimental-strip-types --test 'test/**/*.test.ts'"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-coding-agent": "1.6.1",
    "@types/node": "^22",
    "typescript": "^5.9.3"
  }
}
